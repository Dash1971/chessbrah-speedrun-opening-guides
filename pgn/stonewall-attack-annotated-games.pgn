clk 0:02:17] } 19. gxf5 { [%clk 0:01:52] } exf5 { [%clk 0:02:12] } 20. Qh4 { [%clk 0:01:49] } h6 { [%clk 0:02:10] } 21. Bxh6 { [%clk 0:01:47] played without calculation. It has to be good. } gxh6 { [%clk 0:02:03] } 22. Qxh6 { [%clk 0:01:47] with Kh1... Rg1 ideas. Also have Rg3 ideas. } Kf7 { [%clk 0:01:56] } 23. Qh8 { [%clk 0:01:12] } Qb6 { [%clk 0:01:46] } 24. Rh7+ { [%clk 0:01:01] } Ke6 { [%clk 0:01:45] } 25. Qe8 { [%clk 0:00:39] Stopping the king escaping. Threatening Rh6+ } (25. Rh6+ Kd7 26. Rxb6 { Aman saw this but also saw mate was better. }) 25... Nf4 { [%clk 0:01:12] } 26. Rh6+ { [%clk 0:00:17] } Kd5 { [%clk 0:01:09] } 27. Qxb5+ { [%clk 0:00:16] } Qxb5 { [%clk 0:01:08] } 28. Rd6# { [%clk 0:00:15] Savage } 1-0

